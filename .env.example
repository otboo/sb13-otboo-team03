# 로컬 개발용 환경변수 예시입니다.
# Docker Compose 실행 전에 이 파일을 .env로 복사하세요.
# 실제 값은 .env에서 관리하고, .env 파일은 Git에 올리지 마세요.

POSTGRES_DB=otboo
POSTGRES_USER=otboo
POSTGRES_PASSWORD=otboo_local
POSTGRES_PORT=5432

# ========================================
# JWT 인증 설정
# ========================================

# JWT 서명 키 (UTF-8 기준 최소 32바이트 이상)
# 각 팀원은 .env 파일에 실제 랜덤 키를 설정해주세요.
# 실제 JWT 서명 키는 Git에 커밋하지 마세요.
JWT_SECRET=

# Refresh Token 쿠키 보안 설정
# 로컬 개발(HTTP): false / 운영 환경(HTTPS): true
JWT_COOKIE_SECURE=false

# ========================================
# Redis 연결 설정
# ========================================

# 로컬 개발 시 Docker Compose로 실행한 Redis 사용
# application.yaml 기본값: localhost:6379
# 별도 설정이 필요 없다면 아래 값을 그대로 사용
#
# [Redis 실행 및 확인]
# Docker Desktop 실행 후 프로젝트 루트에서 (docker compose up -d)
# Redis 컨테이너 상태 확인 (docker compose ps)
# Redis 연결 확인 (docker compose exec redis redis-cli ping) -> (PONG 출력 시 정상)

REDIS_HOST=localhost
REDIS_PORT=6379

# ========================================

# 초기 관리자 계정 설정
# 서버 시작 시 ADMIN 계정이 없으면 아래 정보로 관리자 계정을 자동 생성합니다.
# 로컬 실행 전 .env 파일에 각 환경에 맞는 값을 설정해 주세요.
# 실제 정보는 Git에 커밋하지 마세요.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ========================================

# 비밀번호 초기화 이메일 발송 (Gmail SMTP)
# 1. OTBOO 팀 전용 Gmail 계정 사용
# 2. 이메일, 앱 비밀번호는 디스코드 개발환경-설정-공유에 존재
# 3. 실제 앱 비밀번호는 .env에만 저장하고 Git에 커밋하지 않도록 주의
MAIL_USERNAME=OTBOO팀전용이메일@gmail.com
MAIL_PASSWORD=발급받은앱비밀번호
