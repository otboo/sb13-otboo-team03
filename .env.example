# 로컬 개발용 환경변수 예시입니다.
# Docker Compose 실행 전에 이 파일을 .env로 복사하세요.
# 실제 값은 .env에서 관리하고, .env 파일은 Git에 올리지 마세요.

POSTGRES_DB=otboo
POSTGRES_USER=otboo
POSTGRES_PASSWORD=otboo_local
POSTGRES_PORT=5432

# ========================================
# JWT 인증 설정
# ========================================

# JWT 서명 키 (UTF-8 기준 최소 32바이트 이상)
# 각 팀원은 .env 파일에 실제 랜덤 키를 설정해주세요.
# 실제 JWT 서명 키는 Git에 커밋하지 마세요.
JWT_SECRET=

# Refresh Token 쿠키 보안 설정
# 로컬 개발(HTTP): false / 운영 환경(HTTPS): true
JWT_COOKIE_SECURE=false

# ========================================
# Redis 연결 설정
# ========================================

# 로컬 개발 시 Docker Compose로 실행한 Redis 사용
# application.yaml 기본값: localhost:6379
# 별도 설정이 필요 없다면 아래 값을 그대로 사용 (Docker Compose로 애플리케이션을 실행하면 REDIS_HOST는 redis로 자동 재정의됩니다.)
#
# [Redis 실행 및 확인]
# Docker Desktop 실행 후 프로젝트 루트에서 (docker compose up -d)
# Redis 컨테이너 상태 확인 (docker compose ps)
# Redis 연결 확인 (docker compose exec redis redis-cli ping) -> (PONG 출력 시 정상)

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_NOTIFICATION_CHANNEL=otboo:notifications
REDIS_DIRECT_MESSAGE_CHANNEL=otboo:direct-messages

# ========================================

# Kafka 연결 설정
# Confluent Cloud 클러스터 기준입니다. API Key와 Secret은 .env에만 저장하세요.
KAFKA_BOOTSTRAP_SERVERS=pkc-e82om.ap-northeast-2.aws.confluent.cloud:9092
KAFKA_NOTIFICATION_TOPIC=otboo.notification.events
KAFKA_NOTIFICATION_DLT_TOPIC=otboo.notification.events.DLT
KAFKA_CONSUMER_GROUP=otboo-notification
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
# Relay API Key 권한: 클러스터 DESCRIBE, 알림 토픽 WRITE/DESCRIBE,
# 알림 DLT 토픽 WRITE/DESCRIBE
KAFKA_RELAY_API_KEY=
KAFKA_RELAY_API_SECRET=
# Consumer API Key 권한: 클러스터 DESCRIBE, 알림 토픽 READ/DESCRIBE,
# Consumer Group READ
KAFKA_CONSUMER_API_KEY=
KAFKA_CONSUMER_API_SECRET=
# Producer와 Consumer가 서로 다른 Confluent Cloud API Key를 사용한다면 각각 설정하세요.
# 미설정 시 application.yaml이 KAFKA_RELAY_API_KEY/SECRET로 Producer JAAS를 구성합니다.
KAFKA_PRODUCER_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username='<KAFKA_RELAY_API_KEY>' password='<KAFKA_RELAY_API_SECRET>';
KAFKA_CONSUMER_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username='<KAFKA_CONSUMER_API_KEY>' password='<KAFKA_CONSUMER_API_SECRET>';
# 하위 호환용 Consumer JAAS 설정
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username='<KAFKA_CONSUMER_API_KEY>' password='<KAFKA_CONSUMER_API_SECRET>';
KAFKA_PRODUCER_IDEMPOTENCE=true
KAFKA_PRODUCER_SEND_TIMEOUT=PT30S
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=30000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=10000
KAFKA_CONSUMER_RETRY_BACKOFF_MS=1000
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=2
REDIS_NOTIFICATION_PUBLISH_MAX_ATTEMPTS=3
REDIS_NOTIFICATION_PUBLISH_BACKOFF_MS=200

# ========================================

# 초기 관리자 계정 설정
# 서버 시작 시 ADMIN 계정이 없으면 아래 정보로 관리자 계정을 자동 생성합니다.
# 로컬 실행 전 .env 파일에 각 환경에 맞는 값을 설정해 주세요.
# 실제 정보는 Git에 커밋하지 마세요.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=


# ========================================
# AWS S3 설정
# ========================================

STORAGE_TYPE=local
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2

# ========================================

# 비밀번호 초기화 이메일 발송 (Gmail SMTP)
# 1. OTBOO 팀 전용 Gmail 계정 사용
# 2. 이메일, 앱 비밀번호는 디스코드 개발환경-설정-공유에 존재
# 3. 실제 앱 비밀번호는 .env에만 저장하고 Git에 커밋하지 않도록 주의
MAIL_USERNAME=
MAIL_PASSWORD=

# ========================================
# 운영 환경 DB 설정 (prod 프로필)
# ========================================

# 운영 배포 시 별도 환경변수 또는 비밀정보 관리 서비스에서 주입합니다.
# 로컬 Docker Compose 실행에는 필요하지 않습니다.
#
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# ========================================
# 카카오 로컬 REST API 설정 (좌표 -> 행정동 변환)
# 키는 디스코드 개발환경-설정-공유 채널 참고
# ========================================
KAKAO_API_KEY=

# ========================================
# OpenWeatherMap REST API 설정
# ========================================
OPENWEATHER_API_KEY=


# ========================================
# 의상 제목·전체 속성 기반 Groq 추천
# ========================================

RECOMMENDATION_LLM_ENABLED=false
GROQ_API_KEY=
GROQ_RECOMMENDATION_MODEL=openai/gpt-oss-120b

# ========================================

# 소셜 로그인에 사용할 Google 웹 OAuth 클라이언트와 Kakao REST API 키, Client Secret을 .env에 설정하세요.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# ========================================
# LLM 추천에 연결되는 외부 스타일 RAG
# ========================================
OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=bge-m3:latest
RAG_EMBEDDING_MODEL_DIGEST=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab

RAG_JDBC_URL=jdbc:postgresql://localhost:5433/outfit_references
RAG_POSTGRES_PORT=5433
RAG_POSTGRES_USER=outfit_references
# 실제 비밀번호는 .env에만 설정합니다. 아래 값은 입력 위치를 보여주는 예시입니다.
RAG_POSTGRES_PASSWORD=your-local-rag-db-password
